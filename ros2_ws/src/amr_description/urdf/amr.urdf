<?xml version="1.0"?>
<!--
  amr.urdf

  Milestone 1: minimal TF tree for the AMR.

  ALL numeric dimensions and offsets in this file are PLACEHOLDERS.
  They exist only so robot_state_publisher has a valid kinematic tree to
  broadcast (base_link -> left_wheel_link / right_wheel_link / camera_link /
  imu_link). None of these numbers come from measured hardware. Replace every
  value marked "PLACEHOLDER" once the real chassis, wheel, camera, and IMU
  geometry are known.
-->
<robot name="amr">

  <!-- ============================================================ -->
  <!-- base_link: main chassis                                      -->
  <!-- PLACEHOLDER box: 0.30 x 0.20 x 0.10 m (length x width x height) -->
  <!-- ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.20 0.10"/> <!-- PLACEHOLDER -->
      </geometry>
    </visual>
  </link>

  <!-- ============================================================ -->
  <!-- left_wheel_link                                               -->
  <!-- PLACEHOLDER cylinder: radius 0.05 m, length (width) 0.02 m    -->
  <!-- PLACEHOLDER mount offset: y = +0.12 m (half track width),     -->
  <!-- z = -0.02 m relative to base_link origin                      -->
  <!-- continuous joint: wheel rotates about its own Y axis          -->
  <!-- ============================================================ -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/> <!-- PLACEHOLDER -->
      </geometry>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.12 -0.02" rpy="0 0 0"/> <!-- PLACEHOLDER -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- right_wheel_link                                              -->
  <!-- PLACEHOLDER cylinder: radius 0.05 m, length (width) 0.02 m    -->
  <!-- PLACEHOLDER mount offset: y = -0.12 m (half track width),     -->
  <!-- z = -0.02 m relative to base_link origin                      -->
  <!-- continuous joint: wheel rotates about its own Y axis          -->
  <!-- ============================================================ -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/> <!-- PLACEHOLDER -->
      </geometry>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.12 -0.02" rpy="0 0 0"/> <!-- PLACEHOLDER -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- camera_link                                                   -->
  <!-- PLACEHOLDER box: 0.02 x 0.05 x 0.02 m                         -->
  <!-- PLACEHOLDER mount offset: front-top of chassis                -->
  <!-- fixed joint: camera does not move relative to base_link       -->
  <!-- ============================================================ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.05 0.02"/> <!-- PLACEHOLDER -->
      </geometry>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.14 0 0.08" rpy="0 0 0"/> <!-- PLACEHOLDER -->
  </joint>

  <!-- ============================================================ -->
  <!-- imu_link                                                      -->
  <!-- PLACEHOLDER box: 0.02 x 0.02 x 0.01 m                         -->
  <!-- PLACEHOLDER mount offset: near chassis center, slightly above -->
  <!-- fixed joint: IMU does not move relative to base_link          -->
  <!-- ============================================================ -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/> <!-- PLACEHOLDER -->
      </geometry>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/> <!-- PLACEHOLDER -->
  </joint>

</robot>
